{
  "name": "hypercut",
  "productName": "HyperCut",
  "version": "0.1.0",
  "description": "Local-first silence editing for desktop and browser",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "desktop": "npm run build && electron .",
    "test": "node --test tests/*.test.mjs",
    "test:media": "node --test tests/media.integration.mjs",
    "test:api": "node --test tests/api.integration.mjs tests/ai-api.integration.mjs",
    "test:failures": "node --test tests/failures.integration.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "fixtures": "node scripts/fixtures.mjs",
    "package:desktop": "npm run build && node scripts/package-desktop.mjs",
    "test:compatibility": "node --test tests/compatibility.integration.mjs"
  },
  "dependencies": {
    "express": "^5.2.1",
    "lucide-react": "^1.41.0",
    "multer": "^2.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.2.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
