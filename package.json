{
  "name": "hypercut",
  "productName": "HyperCut",
  "version": "0.1.0",
  "description": "Local-first silence editing for desktop and browser",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node scripts/cloud-go.mjs local",
    "desktop": "npm run build && npm run build:server && electron .",
    "test": "node --test tests/*.test.mjs",
    "test:media": "go test ./internal/media",
    "test:speech": "node --test tests/speech.integration.mjs",
    "test:speech:e2e": "node scripts/speech-e2e.mjs",
    "test:speech:offline": "node scripts/speech-offline.mjs",
    "test:api": "npm run test:local:go && go test ./internal/ai",
    "test:claude": "node --test tests/claude-cli.integration.mjs",
    "test:claude:e2e": "node scripts/claude-cli-e2e.mjs",
    "test:failures": "node --test tests/failures.integration.mjs tests/atomic-file.integration.mjs",
    "test:disk-full": "node --test tests/disk-full.integration.mjs",
    "test:recovery": "node scripts/recovery-e2e.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "benchmark:transcription": "node scripts/transcription-benchmark.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "fixtures": "node scripts/fixtures.mjs",
    "package:desktop": "npm run build && npm run build:server && node scripts/package-desktop.mjs",
    "test:compatibility": "node --test tests/compatibility.integration.mjs",
    "setup:transcription": "node scripts/setup-transcription.mjs",
    "test:transcription:end:e2e": "node scripts/transcription-end-e2e.mjs",
    "test:transcription": "node --test tests/transcription.integration.mjs",
    "test:download": "node --test tests/verified-download.integration.mjs",
    "test:captions:e2e": "node scripts/captions-e2e.mjs",
    "test:captions:offline": "node scripts/captions-offline.mjs",
    "test:captions": "node --test tests/caption-style.test.mjs tests/captions.test.mjs tests/caption-rendering.integration.mjs",
    "test:correction": "node --test tests/caption-correction.test.mjs tests/caption-correction-api.integration.mjs",
    "test:glossary:e2e": "node scripts/glossary-e2e.mjs",
    "test:correction:e2e": "node scripts/caption-correction-e2e.mjs",
    "test:effects": "node --test tests/effects.test.mjs tests/effects.integration.mjs",
    "test:effects:e2e": "node scripts/effects-e2e.mjs",
    "test:ai-effects": "node --test tests/effect-proposal.test.mjs tests/effect-proposal-api.integration.mjs",
    "test:ai-effects:e2e": "node scripts/ai-effects-e2e.mjs",
    "test:save:crash": "node scripts/desktop-save-crash-e2e.mjs",
    "test:save:native": "node scripts/native-save-dialog-session.mjs",
    "test:benchmark:selection": "node --test tests/benchmark-selection.integration.mjs",
    "test:project:io": "node scripts/project-io-race-e2e.mjs",
    "test:jobs:races": "node scripts/job-cancellation-race-e2e.mjs",
    "test:mcp": "node --test tests/mcp-shares.test.mjs tests/mcp.integration.mjs",
    "test:multilingual": "node --test tests/multilingual.test.mjs tests/multilingual.integration.mjs",
    "test:multilingual:e2e": "node scripts/multilingual-e2e.mjs --desktop",
    "test:multilingual:transcription": "node scripts/multilingual-transcription.mjs",
    "cloud:api": "node scripts/cloud-go.mjs serve",
    "cloud:worker": "node scripts/cloud-go.mjs worker",
    "cloud:user": "node scripts/cloud-go.mjs user",
    "build:server": "node scripts/build-backend.mjs",
    "test:server": "go test -race ./...",
    "test:cloud:go": "npm run build:server && HYPERCUT_CLOUD_API=go HYPERCUT_CLOUD_WORKER=go node --test tests/cloud.integration.mjs tests/cloud-migration.integration.mjs",
    "test:cloud:go:e2e": "npm run build:server && HYPERCUT_CLOUD_API=go HYPERCUT_CLOUD_WORKER=go npm run test:cloud:e2e",
    "test:cloud": "npm run test:cloud:go",
    "test:cloud:e2e": "node scripts/cloud-e2e.mjs",
    "test:local:go": "npm run build:server && HYPERCUT_LOCAL_SERVER=go node --test tests/api.integration.mjs tests/mcp.integration.mjs",
    "test:local:go:e2e": "npm run build && npm run build:server && HYPERCUT_LOCAL_SERVER=go node scripts/e2e.mjs",
    "test:reference:media": "node --test tests/media.integration.mjs",
    "test:reference:api": "node --test tests/api.integration.mjs tests/ai-api.integration.mjs",
    "test:reference:cloud": "node --test tests/cloud.integration.mjs",
    "build:landing": "tsc --noEmit && vite build --mode landing && node scripts/finalize-landing.mjs",
    "preview:landing": "vite preview --outDir site-dist --host 127.0.0.1 --port 4174",
    "test:landing": "node scripts/landing-e2e.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.10",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.2.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "express": "^5.2.1",
    "multer": "^2.3.0",
    "@napi-rs/canvas": "1.0.8",
    "onnxruntime-node": "1.29.0",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "^4.5.4"
  },
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QuokkaCompany/hypercut.git"
  },
  "homepage": "https://github.com/QuokkaCompany/hypercut#readme",
  "bugs": {
    "url": "https://github.com/QuokkaCompany/hypercut/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
